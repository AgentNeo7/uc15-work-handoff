@IsTest private class CaseHandoffActionTest {
 @IsTest static void durableTaskOwnedByCaller() {Contact p=new Contact(LastName='Synthetic'); insert p; Case c=new Case(Subject='Synthetic',Description='Synthetic evidence',ContactId=p.Id,Status='New',Origin='Phone'); insert c; c=[SELECT Id,LastModifiedDate FROM Case WHERE Id=:c.Id]; CaseHandoffAction.Request r=new CaseHandoffAction.Request();r.caseId=c.Id;r.expectedModified=c.LastModifiedDate;r.obligation='Review missing customer response';r.dueDate=Date.today().addDays(1);List<CaseHandoffAction.Result> out=CaseHandoffAction.createTasks(new List<CaseHandoffAction.Request>{r,r});System.assertEquals('OBLIGATION_CREATED',out[0].state);System.assertEquals('HOLD',out[1].state);Task t=[SELECT OwnerId,WhatId,ActivityDate FROM Task WHERE Id=:out[0].taskId];System.assertEquals(UserInfo.getUserId(),t.OwnerId);System.assertEquals(c.Id,t.WhatId);}
 @IsTest static void staleCaseNeverCreatesTask() {Contact p=new Contact(LastName='Synthetic'); insert p; Case c=new Case(Subject='Synthetic',Description='Synthetic evidence',ContactId=p.Id,Status='New',Origin='Phone'); insert c; c=[SELECT Id,LastModifiedDate FROM Case WHERE Id=:c.Id]; CaseHandoffAction.Request r=new CaseHandoffAction.Request();r.caseId=c.Id;r.expectedModified=c.LastModifiedDate.addDays(-1);r.obligation='Review';r.dueDate=Date.today();System.assertEquals('HOLD',CaseHandoffAction.createTasks(new List<CaseHandoffAction.Request>{r})[0].state);System.assertEquals(0,[SELECT COUNT() FROM Task]);}
 @IsTest static void nullRequestHolds() {System.assertEquals('HOLD',CaseHandoffAction.createTasks(new List<CaseHandoffAction.Request>{null})[0].state);}
}
